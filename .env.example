# Copy to .env and fill in. Only the LLM key is required, and only for
# synthesised answers -- ingest and retrieval run fully offline.

# anthropic | openai
SIFT_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Override only if you changed docker-compose.yml
# SIFT_DB_URL=postgresql://sift:sift@localhost:5433/sift
